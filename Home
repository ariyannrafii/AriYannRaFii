                    </div>
                    <div class="space-y-4">
                        <div class="flex items-center gap-3"><i class="fas fa-envelope"></i> rafi@example.com</div>
                        <div class="flex items-center gap-3"><i class="fas fa-phone"></i> +880 1XXX-XXXXXX</div>
                    </div>
                </div>
                <div class="md:w-2/3 p-10">
