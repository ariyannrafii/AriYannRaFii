                        </div>
                        <input type="text" placeholder="Subject" class="w-full bg-gray-700 border-none rounded-lg p-4 focus:ring-2 focus:ring-indigo-500 outline-none">
                        <textarea rows="4" placeholder="Your Message" class="w-full bg-gray-700 border-none rounded-lg p-4 focus:ring-2 focus:ring-indigo-500 outline-none"></textarea>
